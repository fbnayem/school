# apps/ai — example environment.
#
# ─────────────────────────────────────────────────────────────────────────────────────────────
# THERE IS NO DATABASE_URL IN THIS FILE, AND THERE MUST NEVER BE ONE.
#
# This service reaches institutional data only by calling back into apps/api with the caller's
# own bearer token. It holds no database credentials, no service account and no API key for the
# API. `app/guards.py` refuses to start the process if the environment contains anything that
# looks like a connection string. See README.md and docs/07 §1.
# ─────────────────────────────────────────────────────────────────────────────────────────────

AI_ENVIRONMENT=development
AI_PORT=8000
AI_LOG_LEVEL=info

# Where apps/api lives, and the versioned prefix its routes sit behind.
AI_API_BASE_URL=http://localhost:4000
AI_API_PREFIX=api/v1
AI_API_TIMEOUT_SECONDS=20
AI_API_CONNECT_TIMEOUT_SECONDS=5

# mock | openai | anthropic | gemini.
# `mock` needs no credentials and is deterministic. It is refused in production.
AI_PROVIDER=mock
# Leave unset to use the adapter's documented default model.
# AI_MODEL=
AI_MAX_OUTPUT_TOKENS=4096

# Caps on the tool-call loop. Both are safety controls, not tuning knobs: an injected prompt
# that induces an endless tool loop is a denial-of-service attack against the school's own
# inference budget.
AI_MAX_TOOL_ITERATIONS=6
AI_MAX_WALL_CLOCK_SECONDS=45
AI_MAX_MESSAGE_CHARS=8000
AI_MAX_TOOL_RESULT_CHARS=20000

# Comma-separated browser origins. Never a wildcard in production — this service receives the
# caller's bearer token.
AI_CORS_ORIGINS=http://localhost:3000

# ── Provider credentials ────────────────────────────────────────────────────────────────────
# Only the selected provider's key is needed. A provider selected without its key refuses every
# request loudly and names the missing variable in the log — never in a response.

# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

# GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
