# ShikkhaOS — environment template
#
# Copy to `.env` and adjust. The values below match the Docker development stack in
# `infra/docker-compose.yml`, so `pnpm infra:up && cp .env.example .env` gives a working
# development environment with no further configuration.
#
# The API refuses to start with several of these values when NODE_ENV=production — see the
# `superRefine` block in apps/api/src/config/env.ts for the exact list and the reasoning.

# ─── Runtime ──────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
LOG_LEVEL=info
LOG_PRETTY=true

# Comma-separated. Must not contain a wildcard or localhost in production.
CORS_ORIGINS=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────────────
# The API connects as `shikkha_app`: NOT the table owner and WITHOUT bypassrls, which is what
# makes row-level security actually apply to it. Using the migrator role here would silently
# disable tenant isolation, so the production config check refuses it.
DATABASE_URL=postgres://shikkha_app:shikkha_dev_password@localhost:5433/shikkha_dev

# Migrations run as the owner. Only the migration CLI and the seeder use this.
MIGRATION_DATABASE_URL=postgres://shikkha_migrator:shikkha_dev_password@localhost:5433/shikkha_dev

DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Query logs contain student data. Never true outside local debugging.
DATABASE_LOG_QUERIES=false

# ─── Redis ────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ─── Authentication ───────────────────────────────────────────────────────────────────
# Development value only. Generate a real one with:  openssl rand -base64 48
JWT_SECRET=development-only-secret-not-for-production-do-not-ship
JWT_ISSUER=shikkha-os
JWT_AUDIENCE=shikkha-api

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Must be true in production so session cookies require HTTPS.
COOKIE_SECURE=false
# COOKIE_DOMAIN=.yourschool.com
WEB_APP_URL=http://localhost:3000

MAX_FAILED_LOGIN_ATTEMPTS=8
ACCOUNT_LOCK_MINUTES=15

# Argon2id, OWASP baseline. Raise ARGON2_MEMORY_KIB on a server with headroom.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ─── Rate limiting ────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# ─── Storage ──────────────────────────────────────────────────────────────────────────
# `local` is a real adapter with signed, expiring URLs — not a stub — but it is not durable
# and the production config check refuses it.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage-local
STORAGE_URL_SECRET=local-storage-signing-key-dev

# Required when STORAGE_DRIVER=s3. MinIO in the dev stack:
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=shikkha
# S3_ACCESS_KEY_ID=shikkha_dev
# S3_SECRET_ACCESS_KEY=shikkha_dev_password
# S3_FORCE_PATH_STYLE=true

# ─── Development conveniences ─────────────────────────────────────────────────────────
ENABLE_SWAGGER=true
# Shows seeded demo credentials on the login page. Refused in production.
ENABLE_DEMO_HINTS=true

# ─── Web app ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
